alert tcp $EXTERNAL_NET any -> $HOME_NET [21,22,23,80,445,3306,3389,6379,8088] (msg:"NABILO inbound connection to decoy service"; flow:to_server; flags:S; classtype:attempted-recon; sid:9900001; rev:1;)
alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"NABILO repeated SYN activity"; flags:S; threshold:type both, track by_src, count 20, seconds 10; classtype:network-scan; sid:9900002; rev:1;)

